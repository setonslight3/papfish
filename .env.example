# ---------------------------------------------------------------------------
# Web client (apps/web) - these values are public by design.
# The anon key is safe in a browser because Row Level Security decides what it
# can reach. Never put a service-role key in a VITE_ variable.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Query the public Lichess opening explorer for positions the pipeline has not
# aggregated yet. Set to "false" to use only the opening_stats table.
VITE_ENABLE_LIVE_EXPLORER=true
VITE_LICHESS_EXPLORER_URL=https://explorer.lichess.ovh

# Path of the Stockfish worker; the default is copied from the stockfish
# package into public/engine on install/build.
VITE_ENGINE_PATH=/engine/stockfish-18-lite-single.js

# ---------------------------------------------------------------------------
# Data pipeline (tools/pipeline) - server-side only, never bundled.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: existing accounts used by the Row Level Security check.
PAPFISH_TEST_A_EMAIL=
PAPFISH_TEST_A_PASSWORD=
PAPFISH_TEST_B_EMAIL=
PAPFISH_TEST_B_PASSWORD=
