# Production build configuration for Papfish.
#
# Both values below are public by design: the Supabase URL and the anon key are
# compiled into the browser bundle and are what every visitor's browser uses.
# They are safe to keep here because Row Level Security decides what that key can
# reach - a user can only ever read or write their own rows. The service-role key
# is the one that must never appear in this file, in the app, or in Vercel.
#
# Prefer setting these in Vercel (Project Settings -> Environment Variables)?
# Do that and delete this file; the dashboard values win either way.

VITE_SUPABASE_URL=https://urcqnfysobezhzuelofq.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVyY3FuZnlzb2Jlemh6dWVsb2ZxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODcxNjA1MDYsImV4cCI6MjEwMjczNjUwNn0.Uor9YAt_saS3VlzEcd-VTCUR1b-LzTLB1IRAyk9E-pQ

# Query the public Lichess explorer for positions the pipeline has not
# aggregated yet.
VITE_ENABLE_LIVE_EXPLORER=true
